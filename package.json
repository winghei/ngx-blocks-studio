{
  "name": "ngx-blocks-studio",
  "version": "0.2.0",
  "scripts": {
    "ng": "ng",
    "master-css:compile": "node scripts/compile-master-css.mjs",
    "master-css:watch": "node scripts/compile-master-css.mjs --watch",
    "prestart": "npm run build:lib",
    "start": "npm run master-css:compile && ng serve demo",
    "build": "ng build blocks-studio",
    "build:lib": "ng build blocks-studio",
    "build:demo": "npm run build:lib && npm run master-css:compile && ng build demo",
    "watch": "ng build blocks-studio --watch --configuration development",
    "pack:lib": "ng build blocks-studio && cd dist/blocks-studio && npm pack",
    "test": "ng test",
    "test:block-directives": "vitest run --config tests/block-directives/vitest.config.ts",
    "test:block-directives:coverage": "vitest run --config tests/block-directives/vitest.config.ts --coverage",
    "publish:lib": "./scripts/publish-lib.sh",
    "publish:lib:dry": "./scripts/publish-lib.sh --dry-run"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winghei/ngx-blocks-studio.git"
  },
  "bugs": {
    "url": "https://github.com/winghei/ngx-blocks-studio/issues"
  },
  "homepage": "https://github.com/winghei/ngx-blocks-studio#readme",
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@master/css": "^2.0.0-rc.85",
    "@master/css-preset": "^2.0.0-rc.85",
    "@master/css-project": "^2.0.0-rc.85",
    "@master/css-runtime": "^2.0.0-rc.85",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^27.1.0",
    "ng-packagr": "^22.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
